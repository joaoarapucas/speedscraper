# Copie para /etc/speedscraper/env e restrinja: chmod 600, dono root.
# Exemplo com Gmail: gere uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
# 587 usa STARTTLS; 465 usa TLS implicito.
SMTP_PORT=587
SMTP_USER=seu.email@gmail.com
# Valores sem aspas e sem espacos: o Gmail exibe a senha de app em 4 blocos
# ("abcd efgh ijkl mnop"), mas ela deve ser escrita junta (abcdefghijklmnop).
SMTP_PASS=senha-de-app
SMTP_FROM=seu.email@gmail.com
# Um ou mais destinatarios separados por virgula.
ALERT_TO=seu.email@gmail.com
